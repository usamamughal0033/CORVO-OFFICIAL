# CORVO website repo — publish ONLY the site files.
# The Desktop folder is full of huge photos/videos/scripts that must NOT
# go to GitHub. Ignore everything, then allow only the site files below.
/*
!/index.html
!/shop.html
!/categories.html
!/about.html
!/contact.html
!/links.html
!/assets/
!/README.md
!/CNAME
!/.gitignore
!/.gitattributes
# Raw photo/video library: never upload (11 GB). Only the web-sized copies in assets/img/ are published.
/assets/MAIN DATA/
# Source logo JPEGs and font zips: the site uses the copies in assets/img/logos and assets/FONTS/*.otf
/assets/LOGOS/
/assets/FONTS/*.zip
/assets/FONTS/Tondo*
